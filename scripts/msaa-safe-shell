#!/usr/bin/env python3
import sys
from pathlib import Path

_here = Path(__file__).resolve().parent
for _root in (_here / "lib", _here.parent):
    if (_root / "mac_audit_agent").is_dir():
        sys.path.insert(0, str(_root))
        break
from mac_audit_agent.clickfix.safe_shell import main
raise SystemExit(main())
