#!/bin/sh
set -eu
ROOT=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
MODE=${1:-gui}
if [ "$#" -gt 0 ]; then shift; fi
case "$MODE" in
  gui|notifier|daemon|cli|doctor|integrity|protection|release) ;;
  *) echo "Unknown MSAA mode: $MODE" >&2; exit 2 ;;
esac
BOOTSTRAP=""
for candidate in "$ROOT/.venv/bin/python" python3.14 python3.13 python3.12 python3.11 python3.10 python3 /usr/bin/python3; do
  if command -v "$candidate" >/dev/null 2>&1; then BOOTSTRAP=$(command -v "$candidate"); break; fi
done
if [ -z "$BOOTSTRAP" ]; then echo "No usable Python interpreter found. Install standard CPython 3.12 or 3.13." >&2; exit 2; fi
SELECTED=$($BOOTSTRAP -c "from mac_audit_agent.runtime.python_selector import select_best_python_for_mode; print(select_best_python_for_mode('$MODE', __import__('pathlib').Path('$ROOT')).selected_executable)" 2>/dev/null || true)
if [ -z "$SELECTED" ]; then
  echo "No validated Python was found for mode '$MODE'. Running the headless doctor with $BOOTSTRAP." >&2
  exec "$BOOTSTRAP" -m mac_audit_agent --doctor "$@"
fi
echo "MSAA selected interpreter: $SELECTED" >&2
case "$MODE" in
  gui) exec "$SELECTED" -m mac_audit_agent "$@" ;;
  doctor) exec "$SELECTED" -m mac_audit_agent --doctor "$@" ;;
  protection) exec "$SELECTED" -m mac_audit_agent.protection "$@" ;;
  integrity) exec "$SELECTED" -m mac_audit_agent.integrity "$@" ;;
  *) exec "$SELECTED" -m mac_audit_agent "$@" ;;
esac
