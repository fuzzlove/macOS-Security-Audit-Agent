{
  "feature_id": "MSAA_LOCKDOWN_PROFILE_V1",
  "product_name": "MSAA Emergency Protection Mode",
  "name": "Investigation Mode",
  "purpose": "Evidence-first visibility with reduced user disruption.",
  "network_mode": "normal",
  "controls": [
    {
      "id": "application_firewall",
      "description": "Ensure the macOS Application Firewall is enabled.",
      "warning": "The macOS Application Firewall will be enabled.",
      "apply": [
        "/usr/libexec/ApplicationFirewall/socketfilterfw",
        "--setglobalstate",
        "on"
      ],
      "rollback": [
        "/usr/libexec/ApplicationFirewall/socketfilterfw",
        "--setglobalstate",
        "off"
      ],
      "state_probe": "application_firewall"
    }
  ],
  "monitoring": [
    "unsigned_application_execution",
    "suspicious_parent_child",
    "privilege_escalation",
    "shell_execution",
    "unexpected_root_process",
    "launch_agents",
    "launch_daemons",
    "login_items",
    "system_extensions",
    "usb",
    "bluetooth",
    "browser_extensions",
    "suspicious_downloads",
    "file_modification",
    "network_connections"
  ],
  "score_adjustments": {
    "attack_surface_reduction": 15,
    "additional_monitoring": 8
  },
