# Server-only Stripe credentials. Never put live values in this repository or
# in the macOS application bundle.
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=price_replace_me

# Checkout uses a recurring Price by default. Use "payment" for a one-time
# purchase and set MSAA_STRIPE_ONE_TIME_LICENSE_DAYS as needed.
MSAA_STRIPE_CHECKOUT_MODE=subscription
MSAA_STRIPE_ONE_TIME_LICENSE_DAYS=365
MSAA_STRIPE_SUCCESS_URL=https://licenses.example.com/checkout/success?session_id={CHECKOUT_SESSION_ID}
MSAA_STRIPE_CANCEL_URL=https://licenses.example.com/checkout/cancel
MSAA_STRIPE_LIVE_MODE=0
MSAA_STRIPE_AUTOMATIC_TAX=0

# Licensing state and server-side signing. The private key must live outside
# the repository and outside all desktop application artifacts.
MSAA_STRIPE_DATABASE=/var/lib/msaa-licensing/orders.sqlite3
MSAA_LICENSE_PRIVATE_KEY=/run/secrets/msaa-license-ed25519.pem
MSAA_LICENSE_PRIVATE_KEY_PASSWORD=
MSAA_LICENSE_SIGNING_KEY_ID=msaa-commercial-2026-01
MSAA_ACTIVATION_TOKEN_SECRET=replace_with_at_least_32_random_bytes
MSAA_STRIPE_LICENSE_EDITION=COMMERCIAL
MSAA_STRIPE_LICENSE_FEATURES=commercial_use,professional_reports

# Desktop-only public service URLs. These contain no Stripe or signing secrets.
MSAA_LICENSE_CHECKOUT_URL=https://licenses.example.com/v1/checkout
MSAA_LICENSE_ACTIVATION_URL=https://licenses.example.com/v1/activate
