{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://msaa.local/schemas/authorization-context-1.0.json",
  "title": "MSAA Authorization Context",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version","authorization_id","engagement_id","mission_id","mission_purpose","authorizing_entity","accountable_approver","authorization_reference","system_owner","asset_owner","environment","authorization_status","valid_from","valid_until","in_scope_assets","out_of_scope_assets","approved_accounts_or_identities","approved_network_ranges","approved_data_sources","authorized_time_windows","permitted_actions","permitted_operational_effects","prohibited_actions","prohibited_operational_effects","permitted_attack_domains","permitted_attack_tactics","permitted_attack_techniques","prohibited_attack_techniques","applicable_jurisdictions","data_classification","controlled_information_categories","data_retention_requirements","logging_requirements","evidence_preservation_requirements","deconfliction_contact","emergency_contact","stop_conditions","rollback_plan","recovery_plan","required_human_approval_points","approved_framework_versions","output_mode","approval_evidence_reference","created_at","updated_at","approved_at","revoked_at","revocation_reason"],
  "properties": {
    "schema_version":{"const":"1.0"},
    "authorization_id":{"type":"string","pattern":"^[A-Za-z0-9._-]{3,128}$"},"engagement_id":{"type":"string","minLength":1,"maxLength":128},"mission_id":{"type":"string","minLength":1,"maxLength":128},"mission_purpose":{"type":"string","minLength":10,"maxLength":2000},
    "authorizing_entity":{"type":"string","minLength":1,"maxLength":256},"accountable_approver":{"type":"string","minLength":1,"maxLength":256},"authorization_reference":{"type":"string","minLength":1,"maxLength":512},"system_owner":{"type":"string","minLength":1,"maxLength":256},"asset_owner":{"type":"string","minLength":1,"maxLength":256},
    "environment":{"enum":["production","staging","lab","laboratory","sandbox","training","test_fixture"]},"authorization_status":{"enum":["draft","pending","approved","disputed","suspended","revoked","expired"]},
    "valid_from":{"type":"string","format":"date-time"},"valid_until":{"type":"string","format":"date-time"},"created_at":{"type":"string","format":"date-time"},"updated_at":{"type":"string","format":"date-time"},"approved_at":{"type":"string"},"revoked_at":{"type":"string"},"revocation_reason":{"type":"string","maxLength":1000},
    "in_scope_assets":{"$ref":"#/$defs/nonemptyStrings"},"out_of_scope_assets":{"$ref":"#/$defs/strings"},"approved_accounts_or_identities":{"$ref":"#/$defs/strings"},"approved_network_ranges":{"$ref":"#/$defs/strings"},"approved_data_sources":{"$ref":"#/$defs/strings"},"authorized_time_windows":{"$ref":"#/$defs/strings"},"permitted_actions":{"$ref":"#/$defs/nonemptyStrings"},"permitted_operational_effects":{"$ref":"#/$defs/nonemptyStrings"},"prohibited_actions":{"$ref":"#/$defs/strings"},"prohibited_operational_effects":{"$ref":"#/$defs/strings"},"permitted_attack_domains":{"$ref":"#/$defs/strings"},"permitted_attack_tactics":{"$ref":"#/$defs/strings"},"permitted_attack_techniques":{"$ref":"#/$defs/strings"},"prohibited_attack_techniques":{"$ref":"#/$defs/strings"},"applicable_jurisdictions":{"$ref":"#/$defs/nonemptyStrings"},"controlled_information_categories":{"$ref":"#/$defs/strings"},"logging_requirements":{"$ref":"#/$defs/strings"},"evidence_preservation_requirements":{"$ref":"#/$defs/strings"},"stop_conditions":{"$ref":"#/$defs/nonemptyStrings"},"required_human_approval_points":{"$ref":"#/$defs/strings"},
    "data_classification":{"type":"string","minLength":1,"maxLength":128},"data_retention_requirements":{"type":"string","minLength":1,"maxLength":1000},"deconfliction_contact":{"type":"string","minLength":1,"maxLength":256},"emergency_contact":{"type":"string","minLength":1,"maxLength":256},"rollback_plan":{"type":"string","minLength":1,"maxLength":2000},"recovery_plan":{"type":"string","minLength":1,"maxLength":2000},"approval_evidence_reference":{"type":"string","minLength":1,"maxLength":512},
    "approved_framework_versions":{"type":"object","additionalProperties":{"type":"string","minLength":1},"maxProperties":50},"output_mode":{"enum":["ADVISORY","SIMULATION","LAB_EXECUTION","AUTHORIZED_OPERATIONAL"]}
  },
  "$defs":{"strings":{"type":"array","items":{"type":"string","minLength":1,"maxLength":512},"maxItems":1000,"uniqueItems":true},"nonemptyStrings":{"type":"array","minItems":1,"items":{"type":"string","minLength":1,"maxLength":512},"maxItems":1000,"uniqueItems":true}}
}
