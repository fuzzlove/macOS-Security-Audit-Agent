<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.fuzzlove.MacAuditAgent.EndpointSecuritySensor</string>
    <key>ProgramArguments</key>
    <array>
        <string>/Library/Application Support/MacAuditAgent/bin/MSAAEndpointSecuritySensor.app/Contents/MacOS/MSAAEndpointSecuritySensor</string>
        <string>--connect</string>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>10</integer>
    <key>ProcessType</key>
    <string>Background</string>
    <key>StandardOutPath</key>
    <string>/dev/null</string>
    <key>StandardErrorPath</key>
    <string>/Library/Application Support/MacAuditAgent/logs/endpoint-security-sensor.log</string>
</dict>
</plist>
